[Unit]
Description=omavault auto-locking hardened password vault daemon
Documentation=https://github.com/criptocbas/omavault
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omavault daemon --timeout 300 --max-session 3600
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

# User-unit-effective seccomp & process hardening
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
# NOTE: `~` only inverts when it is the FIRST character of an assignment, so the allow-list and
# the deny-list MUST be separate lines (a single mixed line silently ignores every `~@group`).
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @module @raw-io @reboot @swap @clock @cpu-emulation @debug @obsolete
SystemCallErrorNumber=EPERM
# Kernel / host surface the daemon never needs (verified to keep the daemon, the logind
# pre-sleep inhibitor and /sys/class/hidraw discovery working in a sandboxed test run).
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateIPC=yes
IPAddressDeny=any
# Not enabled, by design:
# - ProtectProc=invisible / ProcSubset=pid: break the /proc screen-locker (hyprlock) detector.
# - ProtectSystem=strict: would make vaults outside ~/.local/share (OMAVAULT_PATH) unsaveable.
# - PrivateNetwork=yes: blocks AF_NETLINK, which libudev FIDO2 HID discovery needs.
# - CapabilityBoundingSet=: no effect in user units (the user manager holds no capabilities).
KeyringMode=private
# AF_UNIX for local IPC socket, Hyprland IPC, and the system D-Bus (logind pre-sleep) + AF_NETLINK for libudev FIDO2 HID discovery
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StandardInput=null
LimitCORE=0
LimitNOFILE=1024
UMask=0077
# Note: unprivileged `systemd --user` cannot raise RLIMIT_MEMLOCK above the session
# hard limit. If `omavault status` reports mlock=false, configure
# `/etc/security/limits.d/99-omavault.conf` with `@wheel - memlock unlimited`.

[Install]
WantedBy=graphical-session.target
