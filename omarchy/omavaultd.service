[Unit]
Description=omavault auto-locking hardened password vault daemon
Documentation=https://github.com/criptocbas/omavault
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/omavault daemon --timeout 300
KillSignal=SIGTERM
TimeoutStopSec=5
Restart=on-failure
RestartSec=2

# User-unit-effective seccomp & process hardening
NoNewPrivileges=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service ~@privileged ~@mount ~@module ~@raw-io ~@reboot ~@swap ~@clock ~@cpu-emulation ~@debug ~@obsolete
SystemCallErrorNumber=EPERM
KeyringMode=private
# AF_UNIX for local IPC socket, Hyprland IPC, and logind busctl + AF_NETLINK for libudev FIDO2 HID discovery
RestrictAddressFamilies=AF_UNIX AF_NETLINK
StandardInput=null
LimitCORE=0
LimitNOFILE=1024
UMask=0077
# Note: unprivileged `systemd --user` cannot raise RLIMIT_MEMLOCK above the session
# hard limit. If `omavault status` reports mlock=false, configure
# `/etc/security/limits.d/99-omavault.conf` with `@wheel - memlock unlimited`.

[Install]
WantedBy=graphical-session.target
