# Maintainer: Omarchy User
pkgname=omavault
pkgver=0.1.0
pkgrel=1
pkgdesc="Bulletproof, memory-hardened Rust password manager for Omarchy Linux (Arch + Hyprland + Wayland)"
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=(
    'libfido2: FIDO2 / YubiKey hmac-secret hardware 2FA support'
    'foot: zero-scrollback TUI terminal launcher on Omarchy 4.5+'
)
makedepends=('cargo')

build() {
    cd "$startdir/.."
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo build --frozen --release
}

check() {
    cd "$startdir/.."
    cargo test --frozen
}

package() {
    cd "$startdir/.."
    install -Dm755 "target/release/omavault" "$pkgdir/usr/bin/omavault"
    install -Dm644 "omarchy/omavaultd.service" "$pkgdir/usr/lib/systemd/user/omavaultd.service"
    install -Dm644 "omarchy/omavault.lua" "$pkgdir/usr/share/doc/$pkgname/omavault.lua"
    install -Dm644 "omarchy/hypr-omavault.conf" "$pkgdir/usr/share/doc/$pkgname/hypr-omavault.conf"
    install -Dm644 "omarchy/hypridle-hook.conf" "$pkgdir/usr/share/doc/$pkgname/hypridle-hook.conf"
}
